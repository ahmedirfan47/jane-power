# ────────────────────────────────────────────────────────────
# jane-power — environment reference
# Copy the vars you need into apps/web/.env.local (and later apps/gateway/.env)
# NEVER commit real values. Only this .example file is committed.
# ────────────────────────────────────────────────────────────

# ---- App (Phase 0) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase — Auth + Postgres (Phase 1) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---- Realtime gateway (Phase 2/3) ----
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8080
GATEWAY_TOKEN_SECRET=

# ---- Upstash Redis (Phase 3) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Market data providers (Phase 3+) ----
BINANCE_WS_URL=wss://stream.binance.com:9443
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=

# ---- Observability (Phase 8) ----
NEXT_PUBLIC_SENTRY_DSN=